# Copy this file to .env (same folder) and paste your key.
# Get a free key at https://aistudio.google.com/apikey
# ADK finds this file by walking up from the agent's folder, so one .env
# at the repo root works for every agent in agents/.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY=paste-your-key-here

# Using Vertex AI instead? Comment out the two lines above and use:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
