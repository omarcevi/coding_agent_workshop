# `bash scripts/setup.sh` writes .env for you, from your gcloud project.
# ADK finds .env by walking up from the agent's folder, so one .env at the
# repo root works for every agent in agents/.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# No billing account? Use a free key from https://aistudio.google.com/apikey instead:
# run `uv run python scripts/set_key.py`, which sets these two lines for you.
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GEMINI_API_KEY=paste-your-key-here
